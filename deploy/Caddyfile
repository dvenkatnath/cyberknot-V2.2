{
  email {$ACME_EMAIL}
}

{$DOMAIN} {
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "no-referrer"
    Permissions-Policy "camera=(), microphone=(), geolocation=()"
    # CSP: index.html is a single file with the entire app inline (no build-time
    # nonce/hash pipeline), so script-src needs 'unsafe-inline' or every inline
    # <script> gets silently blocked. wasm-unsafe-eval is required for Emscripten
    # WASM instantiation. connect-src needs blob: so fetch() against the blob:
    # object URLs used for downloaded files isn't blocked (see e2e-test.mjs,
    # which caught this the hard way against production).
    Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; connect-src 'self' wss: stun: turn: blob:; img-src 'self' data:; style-src 'self' 'unsafe-inline'; frame-ancestors 'none'; base-uri 'none';"
  }

  # Blob parts are already client-side AES-GCM encrypted before upload — pure
  # high-entropy binary. gzip/zstd cannot shrink that at all, but Caddy still
  # spends real CPU/time trying on every response, which measurably throttles
  # download throughput (measured: ~40 Mbps upload vs ~11 Mbps download on the
  # same link before this fix — encode only touches response bodies, so PUT
  # was unaffected while GET was throttled). Keep this route uncompressed.
  handle /api/v1/blobs/* {
    reverse_proxy keyserver:8080
  }

  handle /api/* {
    encode gzip zstd
    reverse_proxy keyserver:8080
  }

  handle {
    encode gzip zstd
    root * /srv/dist
    try_files {path} /index.html
    file_server
  }
}
